          <mxGeometry x="1555" y="1730" width="775" height="160" as="geometry" />
        </mxCell>
        <mxCell id="text_191" value="绘图假设 / 待实现确认" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial Unicode MS;fontSize=23;fontColor=#a25d14;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1828.0" y="1743.3" width="229.0" height="36.800000000000004" as="geometry" />
        </mxCell>
        <mxCell id="text_192" value="各电极共享 Encoder 参数，可展平为 [B×21,N,40]" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial Unicode MS;fontSize=23;fontColor=#a25d14;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1689.5" y="1775.5" width="506.0" height="36.800000000000004" as="geometry" />
        </mxCell>
        <mxCell id="text_193" value="跳接暂按相加；若用拼接，需要补投影与维度定义" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial Unicode MS;fontSize=23;fontColor=#a25d14;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1687.5" y="1807.6999999999998" width="510.0" height="36.800000000000004" as="geometry" />
        </mxCell>
        <mxCell id="text_194" value="21→21 与 21→1 的卷积核 / 分组方式未在录音定死" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial Unicode MS;fontSize=23;fontColor=#a25d14;spacing=0;" vertex="1" parent="1">
