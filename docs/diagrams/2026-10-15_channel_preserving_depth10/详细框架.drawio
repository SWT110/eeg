        <mxCell id="text_121" value="[B,D,C,N] → [B,C,N,D]" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial Unicode MS;fontSize=22;fontColor=#243449;spacing=0;" vertex="1" parent="1">
