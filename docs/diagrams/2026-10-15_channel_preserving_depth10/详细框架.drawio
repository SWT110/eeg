        <mxCell id="text_126" value="FFT [B,21,58,40]" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial Unicode MS;fontSize=22;fontColor=#243449;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="2047.0" y="819.6999999999999" width="166.0" height="35.2" as="geometry" />
        </mxCell>
        <mxCell id="text_127" value="移走原 Stem 的跨电极空间卷积 Conv2d(40→40, k=(21,1))；仅删除 squeeze 无法恢复已被融合的电极维。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial Unicode MS;fontSize=23;fontColor=#a25d14;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="63" y="901.6" width="1083.0" height="36.800000000000004" as="geometry" />
        </mxCell>
        <mxCell id="text_128" value="N = floor((L−24−75)/15)+1；L_Time=1920 → N=122；L_FFT=961 → N=58。40 来自卷积滤波器 / 嵌入维。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial Unicode MS;fontSize=22;fontColor=#53677c;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="63" y="940.4" width="1029.0" height="35.2" as="geometry" />
        </mxCell>
        <mxCell id="text_129" value="③ 单域 Encoder 展开：Time 和 FFT 各运行一套" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial Unicode MS;fontSize=28;fontColor=#243449;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="63" y="1027.6" width="607.0" height="44.800000000000004" as="geometry" />
        </mxCell>
        <mxCell id="text_130" value="下图 N=122（Time）或 58（FFT）；橙色线为新增跨电极信息" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontFamily=Arial Unicode MS;fontSize=20;fontColor=#53677c;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1780.0" y="1034.0" width="557.0" height="32.0" as="geometry" />
        </mxCell>
        <mxCell id="text_131" value="输入 X₀ = [B,21,N,40]" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial Unicode MS;fontSize=26;fontColor=#243449;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="63" y="1074.2" width="245.0" height="41.6" as="geometry" />
        </mxCell>
