        <mxCell id="text_177" value="Time 4880 / FFT 2320" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial Unicode MS;fontSize=22;fontColor=#243449;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="386.5" y="1507.8000000000002" width="217.0" height="35.2" as="geometry" />
        </mxCell>
        <mxCell id="text_178" value="④ Block 与分类头：沿用基线结构，默认超参数先回归" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial Unicode MS;fontSize=28;fontColor=#243449;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="63" y="1652.6" width="677.0" height="44.800000000000004" as="geometry" />
        </mxCell>
        <mxCell id="text_179" value="depth=10 为导师指定；仓库默认 depth=6，因此不能全部直接用默认值" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontFamily=Arial Unicode MS;fontSize=20;fontColor=#53677c;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1704.0" y="1659.0" width="633.0" height="32.0" as="geometry" />
        </mxCell>
        <mxCell id="block_detail" value="" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;fillColor=#e7f0dd;strokeColor=#cbd5e1;strokeWidth=1.3;" vertex="1" parent="1">
          <mxGeometry x="65" y="1730" width="740" height="160" as="geometry" />
        </mxCell>
        <mxCell id="text_181" value="单个 TransformerEncoderBlock" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial Unicode MS;fontSize=24;fontColor=#243449;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="267.5" y="1740.3999999999999" width="335.0" height="38.400000000000006" as="geometry" />
        </mxCell>
        <mxCell id="text_182" value="x₁ = x + Dropout(MHA(LayerNorm(x)))" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial Unicode MS;fontSize=24;fontColor=#243449;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="232.0" y="1774.0" width="406.0" height="38.400000000000006" as="geometry" />
        </mxCell>
        <mxCell id="text_183" value="out = x₁ + Dropout(FFN(LayerNorm(x₁)))" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial Unicode MS;fontSize=24;fontColor=#243449;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="220.5" y="1807.6" width="429.0" height="38.400000000000006" as="geometry" />
        </mxCell>
        <mxCell id="text_184" value="D=40；heads=5；FFN=40→160→40；dropout=0.5" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial Unicode MS;fontSize=24;fontColor=#243449;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="166.5" y="1841.2" width="537.0" height="38.400000000000006" as="geometry" />
        </mxCell>
        <mxCell id="head_detail" value="" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;fillColor=#e1f0ed;strokeColor=#cbd5e1;strokeWidth=1.3;" vertex="1" parent="1">
          <mxGeometry x="845" y="1730" width="670" height="160" as="geometry" />
        </mxCell>
        <mxCell id="text_186" value="末端分类（双域拼接按原图保留）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial Unicode MS;fontSize=23;fontColor=#243449;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1005.5" y="1743.3" width="349.0" height="36.800000000000004" as="geometry" />
        </mxCell>
        <mxCell id="text_187" value="4880 + 2320 → 7200 → 256 → 32 → 3" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial Unicode MS;fontSize=23;fontColor=#243449;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="992.5" y="1775.5" width="375.0" height="36.800000000000004" as="geometry" />
        </mxCell>
        <mxCell id="text_188" value="ELU；分类头 dropout=0.5 / 0.3" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial Unicode MS;fontSize=23;fontColor=#243449;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1019.5" y="1807.6999999999998" width="321.0" height="36.800000000000004" as="geometry" />
        </mxCell>
        <mxCell id="text_189" value="单一三分类交叉熵；不再做三组深度损失加权" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial Unicode MS;fontSize=23;fontColor=#243449;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="948.0" y="1839.8999999999999" width="464.0" height="36.800000000000004" as="geometry" />
        </mxCell>
