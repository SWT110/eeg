    },
    {
      "id": "rule_1",
      "x": 690,
      "y": 1180,
      "text": "① Time / FFT 各自拥有 3 个 Encoder；depth=11、10、8，六个 Encoder 参数互不共享",
      "fontSize": 18,
      "color": "#20242c",
      "parentId": null,
      "anchor": "free",
      "dx": 0,
      "dy": 0
    },
    {
      "id": "rule_2",
      "x": 690,
      "y": 1230,
      "text": "② loss_softmax 模式关闭域内 feature Softmax；对应深度先配对，再由三个独立 Head 分类",
      "fontSize": 18,
      "color": "#20242c",
      "parentId": null,
      "anchor": "free",
      "dx": 0,
      "dy": 0
    },
    {
      "id": "rule_3",
      "x": 690,
      "y": 1280,
      "text": "③ 每个 paired feature：4880 + 2320 = 7200；Head：7200→256→32→3",
      "fontSize": 18,
      "color": "#20242c",
      "parentId": null,
      "anchor": "free",
      "dx": 0,
      "dy": 0
    },
    {
      "id": "rule_4",
      "x": 2050,
      "y": 1180,
      "text": "④ w=softmax(branch_loss_weight_logits)，零初始化时 w=(1/3,1/3,1/3)",
      "fontSize": 18,
      "color": "#20242c",
      "parentId": null,
      "anchor": "free",
      "dx": 0,
      "dy": 0
    },
    {
      "id": "rule_5",
      "x": 2050,
      "y": 1230,
      "text": "⑤ 训练：L=Σwᵢ·CE(zᵢ,y)+0.2·meanᵢCE(zᵢ,y)，不对 fused logits 另算 CE",
      "fontSize": 18,
      "color": "#20242c",
      "parentId": null,
      "anchor": "free",
      "dx": 0,
      "dy": 0
    },
    {
      "id": "rule_6",
      "x": 2050,
      "y": 1280,
      "text": "⑥ 推理：z=Σwᵢzᵢ；同时返回 fused_features=Σwᵢ·paired_featuresᵢ",
      "fontSize": 18,
      "color": "#20242c",
      "parentId": null,
      "anchor": "free",
      "dx": 0,
      "dy": 0
    },
